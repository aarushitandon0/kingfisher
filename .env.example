# Kingfisher — copy to .env and fill in. NEVER commit .env.

# --- Sentinel Hub OAuth client (CDSE dashboard: shapps.dataspace.copernicus.eu) ---
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# --- PostGIS (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql+psycopg://kingfisher:kingfisher@localhost:5432/kingfisher

# --- Climate Data Store personal access token (optional; ERA5-Land cross-check) ---
CDS_API_KEY=

# --- Runtime ---
KINGFISHER_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=console        # console | json
CACHE_DIR=data/raw/_cache
