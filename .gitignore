# --- Secrets ---
.env
.env.*
!.env.example
*.pem
.cdsapirc

# --- Data: everything except the hand-curated reference set ---
# Downloaded datasets live under data/raw/ and are NEVER committed. As of the first
# fetch that is ~800 MB: OSM (Overpass JSON + Geofabrik .pbf), Copernicus DEM GLO-30
# tiles, ESA WorldCover, GHS-POP, Open-Meteo JSON, Sentinel Hub Statistical responses.
# Re-acquire with:  python scripts/fetch_datasets.py
# Provenance for every file is tracked in DATA_INVENTORY.md (local only, not committed).
data/raw/
data/interim/
data/processed/
*.part
*.osm.pbf
*.tif
*.tiff
!data/reference/
!data/reference/**

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Frontend ---
node_modules/
frontend/dist/
frontend/.vite/

# --- Models / artefacts ---
artifacts/
*.pkl
*.joblib
*.pt

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json

# --- Private working notes (not published) ---
# Every markdown file is private except README.md (in any folder).
*.md
!README.md
frontend/dist-snapshot/
